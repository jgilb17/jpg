{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(**/.claude/settings.local.json)",
      "Write(**/.claude/settings.local.json)",
      "Edit(.claude/hooks/guard.mjs)",
      "Write(.claude/hooks/guard.mjs)",
      "Edit(**/.claude/hooks/guard.mjs)",
      "Write(**/.claude/hooks/guard.mjs)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Write(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/guard.mjs)",
      "Write(~/.claude/hooks/guard.mjs)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "mcp__Supabase__apply_migration"
    ],
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "mcp__Supabase__execute_sql"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__Supabase__execute_sql|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
