{
  "permissions": {
    "deny": [
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [],
    "allow": [
      "Bash",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__Supabase",
      "mcp__Supabase__execute_sql",
      "mcp__claude_ai_Supabase",
      "mcp__claude_ai_Supabase__execute_sql"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*Supabase__execute_sql|mcp__.*Supabase__apply_migration|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
